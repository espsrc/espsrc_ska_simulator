<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>weblog — {{ manifest.run_id }}</title>
  <style>
    :root {
      --fg: #24292f;
      --muted: #656d76;
      --border: #d8dee4;
      --accent: #0969da;
      --success: #1a7f37;
      --danger: #cf222e;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, -apple-system, sans-serif; color: var(--fg); line-height: 1.5; }
    .container { max-width: 1300px; margin: 0 auto; padding: 2rem 1.5rem; }
    h1 { font-size: 1.5rem; font-weight: 600; }
    h2 { font-size: 1.1rem; font-weight: 600; margin: 2.2rem 0 0.75rem; border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* header */
    .header { margin-bottom: 1.5rem; }
    .header .meta { color: var(--muted); font-size: 0.85rem; margin-top: 0.25rem; }
    .badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; vertical-align: middle; margin-left: 0.5rem; }
    .badge.success { background: rgba(63,185,80,0.15); color: var(--success); }
    .badge.danger  { background: rgba(248,81,73,0.15); color: var(--danger); }
    .badge.running { background: rgba(88,166,255,0.15); color: var(--accent); }

    /* durations summary */
    .durations-summary { display: flex; gap: 2rem; margin: 1.5rem 0; font-size: 0.85rem; color: var(--muted); }
    .durations-summary h3 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.2rem; }

    /* config table */
    .config-row { display: flex; gap: 2rem; align-items: flex-start; flex-wrap: wrap; }
    .config-row table { border-collapse: collapse; font-size: 0.85rem; flex: 1; min-width: 320px; }
    .config-row th { text-align: left; color: var(--muted); font-weight: 500; padding: 0.25rem 1rem 0.25rem 0; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; width: 190px; }
    .config-row td { padding: 0.25rem 1rem 0.25rem 0; font-variant-numeric: tabular-nums; }
    .config-row .plot-container { flex-shrink: 0; text-align: center; }
    .config-row .plot-container img { height: 260px; width: auto; display: block; }
    .config-row .plot-title { font-size: 0.75rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em; margin-bottom: 0.5rem; text-align: left; }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem 2rem; }
    .info-grid table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .info-grid th { text-align: left; color: var(--muted); font-weight: 500; padding: 0.25rem 1rem 0.25rem 0; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; width: 190px; }
    .info-grid td { padding: 0.25rem 1rem 0.25rem 0; font-variant-numeric: tabular-nums; }
    .section-label { font-size: 0.78rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em; margin-bottom: 0.35rem; }

    /* science images */
    .science-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; margin-top: 0.75rem; }
    .science-grid figure { margin: 0; text-align: center; }
    .science-grid img { width: 100%; height: auto; display: block; }
    .science-grid figcaption { font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; }
    .stats-line { font-size: 0.85rem; color: var(--muted); margin-top: 0.5rem; font-variant-numeric: tabular-nums; }

    /* timeline */
    table.timeline { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
    table.timeline th { text-align: left; color: var(--muted); font-weight: 500; padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--border); font-size: 0.75rem; text-transform: uppercase; }
    table.timeline td { padding: 0.3rem 0.5rem; border-bottom: 1px solid #f0f0f0; vertical-align: top; }
    table.timeline tr:last-child td { border-bottom: none; }
    .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 0.3rem; vertical-align: middle; }
    .dot-completed { background: var(--success); }
    .dot-started   { background: var(--accent); }
    .dot-failed    { background: var(--danger); }

    /* supporting gallery */
    .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.75rem; margin-top: 0.75rem; }
    .gallery figure { margin: 0; }
    .gallery img { width: 100%; height: auto; display: block; }
    .gallery figcaption { font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; }

    /* details / config dump */
    details { margin-top: 1.5rem; }
    details summary { cursor: pointer; font-weight: 600; font-size: 1.1rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--border); }
    details pre { background: #f6f8fa; padding: 1rem; overflow-x: auto; font-size: 0.78rem; font-family: "SF Mono", "Fira Code", monospace; border-radius: 6px; margin-top: 0.75rem; }
    details table { width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-top: 0.75rem; }
    details th { text-align: left; color: var(--muted); font-weight: 500; padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--border); font-size: 0.75rem; }
    details td { padding: 0.3rem 0.5rem; border-bottom: 1px solid #f0f0f0; }

    @media (max-width: 700px) {
      .science-grid { grid-template-columns: 1fr; }
      .config-row { flex-direction: column; }
    }

    /* tab navigation for batch imaging */
    .tab-buttons { display: flex; gap: 0.5rem; margin: 0.5rem 0 0; border-bottom: 1px solid var(--border); }
    .tab-button { background: none; border: none; padding: 0.5rem 1rem; font-size: 0.85rem; font-weight: 500; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; }
    .tab-button:hover { color: var(--fg); }
    .tab-button.active { color: var(--accent); border-bottom-color: var(--accent); }
    .tab-panel { display: none; margin-top: 0.75rem; }
    .tab-panel.active { display: block; }
  </style>
  <script>
    function showTab(tag) {
      document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
      document.querySelectorAll('.tab-button').forEach(function(b) { b.classList.remove('active'); });
      document.getElementById('panel-' + tag).classList.add('active');
      document.getElementById('btn-' + tag).classList.add('active');
    }
  </script>
</head>
<body>
  <div class="container">

    <!-- header -->
    <div class="header">
      <h1>{{ manifest.run_id }}<span class="badge {{ manifest.status }}">{{ manifest.status }}</span></h1>
      <div class="meta">
        {{ manifest.started_at.strftime("%Y-%m-%d %H:%M:%S UTC") }}
        {% if total_elapsed %} · {{ total_elapsed }}{% endif %}
        {% if simulation_duration %} · simulation {{ simulation_duration }}{% endif %}
        {% if imaging_duration %} · imaging {{ imaging_duration }}{% endif %}
      </div>
      {% if manifest.config.title %}
      <div style="font-size: 1.05rem; font-weight: 500; margin-top: 0.5rem;">{{ manifest.config.title }}</div>
      {% endif %}
      {% if manifest.config.description %}
      <div style="color: var(--muted); font-size: 0.9rem; margin-top: 0.2rem; line-height: 1.4;">{{ manifest.config.description }}</div>
      {% endif %}
    </div>

    <!-- Observation configuration -->
    <h2>Observation & Telescope</h2>
    <div class="config-row">
      <table>
        <tr><th>Telescope</th><td>{{ manifest.config.telescope }} {% if manifest.config.telescope_version %}({{ manifest.config.telescope_version }}){% endif %}</td></tr>
        {% if dish_diameter %}
        <tr><th>Dish Diameter</th><td>{{ dish_diameter }}</td></tr>
        {% endif %}
        {% if n_stations %}
        <tr><th>Antennas</th><td>{{ n_stations }}</td></tr>
        {% endif %}
        {% if derived_fov %}
        <tr><th>Beam FoV (FWHM)</th><td>{{ derived_fov }} <span style="color:var(--muted); font-size:0.75rem; font-style:italic;">(diffraction limit: 1.25 &lambda;/D)</span></td></tr>
        {% endif %}
        <tr><th>Frequency Range</th><td>{{ observation_summary.frequency_min_mhz }}-{{ observation_summary.frequency_max_mhz }} MHz</td></tr>
        <tr><th>Central Frequency</th><td>{{ observation_summary.central_frequency_mhz }} MHz</td></tr>
        <tr><th>Channels</th><td>{{ observation_summary.n_channels }} x {{ observation_summary.channel_bandwidth_mhz }} MHz</td></tr>
        <tr><th>Total Bandwidth</th><td>{{ observation_summary.total_bandwidth_mhz }} MHz</td></tr>
        <tr><th>Obs Time</th><td>{{ observation_summary.observation_time_s }} s</td></tr>
        {% if observation_summary.n_timesteps %}
        <tr><th>Timesteps</th><td>{{ observation_summary.n_timesteps }}</td></tr>
        {% endif %}
        {% if observation_summary.integration_time_s %}
        <tr><th>Integration</th><td>{{ observation_summary.integration_time_s }} s</td></tr>
        {% endif %}
      </table>
      {% if telescope_plot %}
      <div class="plot-container">
        <div class="plot-title">Telescope Layout</div>
        <a href="{{ telescope_plot.path }}" target="_blank" rel="noopener">
          <img src="{{ telescope_plot.data }}" alt="Telescope layout">
        </a>
      </div>
      {% endif %}
      {% if uv_coverage_plot %}
      <div class="plot-container">
        <div class="plot-title">UV Coverage</div>
        <a href="{{ uv_coverage_plot.path }}" target="_blank" rel="noopener">
          <img src="{{ uv_coverage_plot.data }}" alt="UV coverage">
        </a>
      </div>
      {% endif %}
    </div>


    <!-- Sky Model configuration -->
    {% set sky_ms = manifest.milestones | selectattr("name", "equalto", "sky_model_loaded") | list | first | default(none) %}
    {% if sky_ms and sky_ms.details %}
    <h2>Sky Model</h2>
    <div class="config-row">
      <table>
        <tr><th>Format</th><td>{{ sky_ms.details.get("format", "?") }}</td></tr>
        <tr><th>Sources</th><td>{{ sky_ms.details.get("n_sources", "?") }} sources</td></tr>
        {% if sky_ms.details.get("path") %}
        <tr><th>Path</th><td style="word-break: break-all; font-size: 0.78rem; font-family: monospace;">{{ sky_ms.details.get("path") }}</td></tr>
        {% endif %}
      </table>
      {% if sky_model_plot %}
      <div class="plot-container">
        <div class="plot-title">Full Sky Model</div>
        <a href="{{ sky_model_plot.path }}" target="_blank" rel="noopener">
          <img src="{{ sky_model_plot.data }}" alt="Full sky model representation">
        </a>
      </div>
      {% endif %}
      {% if sky_model_fov_plot %}
      <div class="plot-container">
        <div class="plot-title">Sky Model (FoV Zoom)</div>
        <a href="{{ sky_model_fov_plot.path }}" target="_blank" rel="noopener">
          <img src="{{ sky_model_fov_plot.data }}" alt="Sky model FoV zoomed representation">
        </a>
      </div>
      {% endif %}
    </div>
    {% endif %}

    <!-- Science Products -->
    {% if imaging_tabs %}
    <h2>Imaging Products</h2>
    {% if imaging_tabs | length > 1 %}
    <div class="tab-buttons">
      {% for tab in imaging_tabs %}
      <button id="btn-{{ tab.tag }}" class="tab-button{% if loop.first %} active{% endif %}" onclick="showTab('{{ tab.tag }}')">{{ tab.tag }}</button>
      {% endfor %}
    </div>
    {% endif %}
    {% for tab in imaging_tabs %}
    <div id="panel-{{ tab.tag }}" class="tab-panel{% if loop.first %} active{% endif %}{% if imaging_tabs | length == 1 %} active{% endif %}">
      <div class="info-grid" style="margin-bottom: 1.5rem;">
        <table>
          <tr><th>Image Size</th><td>{{ tab.imaging_summary.image_size }}</td></tr>
          {% if tab.imaging_summary.fov_deg %}
          <tr><th>Total FoV</th><td>{{ tab.imaging_summary.fov_deg }} deg</td></tr>
          {% endif %}
          {% if tab.imaging_summary.pixel_size_arcsec %}
          <tr><th>Pixel Size</th><td>{{ tab.imaging_summary.pixel_size_arcsec }} arcsec</td></tr>
          {% endif %}
          {% if tab.imaging_summary.beam %}
          <tr><th>Beam</th><td>{{ tab.imaging_summary.beam }}</td></tr>
          {% endif %}
          {% for label, value in tab.imager_parameter_rows %}
          <tr><th>{{ label }}</th><td>{{ value }}</td></tr>
          {% endfor %}
        </table>
      </div>
      {% for product in tab.products %}
      <div style="margin-bottom: 2rem;">
        <div style="font-size: 0.9rem; margin-bottom: 0.4rem;">
          <strong>{{ product.product_id }}</strong>
          <span class="badge running">{{ product.imager }}</span>
          {% if product.psf and product.psf.preview %}
            · <a href="{{ product.psf.preview }}" target="_blank" rel="noopener">View PSF</a>
          {% endif %}
        </div>
        {% if product.stats %}
        <div class="stats-line">
          Peak: {{ product.stats.peak }} · RMS: {{ product.stats.rms }}{% if product.stats.snr %} · SNR: {{ product.stats.snr }}{% endif %}
          {% if product.beam %} · Beam: {{ product.beam.bmaj or "?" }} x {{ product.beam.bmin or "?" }}{% if product.beam.bpa %} · BPA {{ product.beam.bpa }}{% endif %}{% endif %}
        </div>
        {% elif product.beam %}
        <div class="stats-line">
          Beam: {{ product.beam.bmaj or "?" }} x {{ product.beam.bmin or "?" }}{% if product.beam.bpa %} · BPA {{ product.beam.bpa }}{% endif %}
        </div>
        {% endif %}
        <div class="science-grid">
          {% if product.model or product.clean or product.residual %}
          {% for item, caption in [(product.model, "Model"), (product.clean, "Clean"), (product.residual, "Residual")] %}
          <figure>
            {% if item and item.preview and item.data %}
              <a href="{{ item.preview }}" target="_blank" rel="noopener"><img src="{{ item.data }}" alt="{{ caption }}"></a>
              <figcaption>{{ caption }}</figcaption>
            {% else %}
              <figcaption style="padding: 3rem 0;">{{ caption }} — not available</figcaption>
            {% endif %}
          </figure>
          {% endfor %}
          {% elif product.dirty %}
          <figure>
            {% if product.dirty.preview and product.dirty.data %}
              <a href="{{ product.dirty.preview }}" target="_blank" rel="noopener"><img src="{{ product.dirty.data }}" alt="Dirty"></a>
              <figcaption>Dirty Image</figcaption>
            {% else %}
              <figcaption style="padding: 3rem 0;">Dirty Image — not available</figcaption>
            {% endif %}
          </figure>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
    {% endif %}

    <!-- Timeline -->
    <h2>Timeline</h2>
    <table class="timeline">
      <thead><tr><th>Time</th><th>Event</th><th>Duration</th><th>Details</th></tr></thead>
      <tbody>
        {% for ms in manifest.milestones %}
        <tr>
          <td style="white-space:nowrap;">{{ ms.timestamp_utc.strftime("%H:%M:%S") }}</td>
          <td><span class="dot dot-{{ ms.status }}"></span>{{ ms.name }}</td>
          <td>{% if ms.elapsed_s %}{{ (ms.elapsed_s // 60)|int }}m {{ (ms.elapsed_s % 60)|int }}s{% endif %}</td>
          <td style="color: var(--muted); font-size: 0.78rem;">
            {% if ms.details %}
              {% if ms.name == "sky_model_loaded" %}{{ ms.details.get("n_sources", "?") }} sources ({{ ms.details.get("format", "?") }})
              {% elif ms.name == "telescope_built" %}{{ ms.details.get("n_stations", "?") }} stations
              {% else %}{{ ms.details | tojson | truncate(120) }}
              {% endif %}
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <!-- Supporting Plots -->
    {% if images %}
    <h2>Supporting Plots</h2>
    <div class="gallery">
      {% for img in images %}
      <figure>
        <a href="{{ img.path }}" target="_blank" rel="noopener"><img src="{{ img.data }}" alt="{{ img.caption }}"></a>
        <figcaption>{{ img.caption }}</figcaption>
      </figure>
      {% endfor %}
    </div>
    {% endif %}

    <!-- Collapsible detail sections -->
    {% if manifest.outputs %}
    <details>
      <summary>Output Records</summary>
      <table>
        <thead><tr><th>Kind</th><th>Path</th><th>Imager</th><th>Role</th></tr></thead>
        <tbody>
          {% for output in manifest.outputs %}
          <tr>
            <td>{{ output.kind }}</td>
            <td>{{ output.path }}</td>
            <td>{{ output.imager or "" }}</td>
            <td>{{ output.role or "" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
    {% endif %}

    <h2>Software Versions</h2>
    <table class="timeline">
      <tbody>
        {% for name, value in software_versions %}
        <tr>
          <th style="text-align:left; color:var(--muted); font-weight:500; padding:0.3rem 0.5rem; width:140px;">{{ name }}</th>
          <td style="padding:0.3rem 0.5rem; font-variant-numeric:tabular-nums;">{{ value }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <details>
      <summary>Resolved Configuration</summary>
      <pre>{{ manifest.config.model_dump_json(indent=2) }}</pre>
    </details>

    {% if manifest.errors %}
    <h2 style="color: var(--danger);">Errors</h2>
    {% for err in manifest.errors %}
    <pre style="background:#fff0f0; padding:1rem; border-radius:6px; font-size:0.82rem; color:var(--danger); margin-bottom:0.5rem;">{{ err }}</pre>
    {% endfor %}
    {% endif %}

  </div>
</body>
</html>
