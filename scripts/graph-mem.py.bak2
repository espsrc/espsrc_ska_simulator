import numpy as np
import matplotlib.pyplot as plt
import os
import time
import argparse

def load_and_plot(csv_path, sep):
    try:
        data = np.genfromtxt(csv_path, delimiter=sep, dtype=str, skip_header=1)
        if data.ndim == 1:
            data = np.array([data])  # ensure 2D for single-row CSV
        x = data[:, 0]
        y = data[:, 1].astype(float)

        plt.clf()
        plt.plot(x, y, marker="o")
        plt.xlabel("Time")
        plt.ylabel("RAM Used (GB)")
        plt.title("Live CSV Plot")
        plt.xticks(rotation=45)
        plt.tight_layout()
        plt.draw()

    except Exception as e:

        print(f"Error reading or plotting data: {e}")



def main():
    parser = argparse.ArgumentParser(description="Live plot from CSV using NumPy.")
    parser.add_argument("csv_path", help="Path to the CSV file to monitor.")
    parser.add_argument("--sep", default=";", help="CSV separator (default: ';')")
    parser.add_argument("--interval", type=float, default=1.0, help="Refresh interval in seconds.")
    args = parser.parse_args()

    plt.ion()
    last_mtime = 0

    while True:
        try:
            mtime = os.path.getmtime(args.csv_path)
            if mtime != last_mtime:
                last_mtime = mtime
                print("CSV changed. Updating plot...")
                load_and_plot(args.csv_path, args.sep)
            plt.pause(args.interval)
        except FileNotFoundError:
            print("CSV file not found. Waiting...")
            time.sleep(args.interval)
        except KeyboardInterrupt:
            print("Exiting...")
            break

if __name__ == "__main__":
    main()
